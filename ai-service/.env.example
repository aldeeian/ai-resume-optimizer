# Shared secret — must match AI_SERVICE_API_KEY in web/.env
AI_SERVICE_API_KEY="change-me-to-a-long-random-string"

# ── LLM provider ─────────────────────────────────────────────────────────────
# "anthropic" (default, paid) or "gemini" (free tier available)
LLM_PROVIDER="anthropic"

# Anthropic — required when LLM_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-6"   # or claude-haiku-4-5 for lower cost

# Gemini — required when LLM_PROVIDER=gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
